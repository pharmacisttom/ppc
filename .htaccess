<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /hos/

    # Direct access to real files or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rewrite all other URLs to index.php
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>
